@model EnrolmentsPageModel
@{
    ViewData["Title"] = "Enrolments";
}

<a asp-action="Events" class="small">&larr; Back to my events</a>
<h2 class="mt-2">Enrolments: @Model.Event.EventName</h2>
<p class="text-muted">@Model.Enrolments.Count participant(s) enrolled</p>

<div class="card rd-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr><th>Participant</th><th>Email</th><th>Category</th><th>Enrolled on</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Enrolments)
                {
                    <tr>
                        <td><strong>@e.ParticipantName</strong></td>
                        <td>@e.ParticipantEmail</td>
                        <td>@e.CategoryName</td>
                        <td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td>
                        <td><partial name="_StatusBadge" model="e.Status" /></td>
                        <td class="text-end">
                            @if (e.Status != "Confirmed")
                            {
                                <form asp-action="ConfirmEnrolment" asp-route-eventId="@Model.Event.EventId"
                                      asp-route-enrolmentId="@e.EnrolmentId" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-rd">Confirm</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Enrolments.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">Nobody has enrolled yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>