@model CategoriesPageModel
@{
    ViewData["Title"] = "Categories";
}

<a asp-action="Events" class="small">&larr; Back to my events</a>
<h2 class="mt-2">Categories: @Model.Event.EventName</h2>
<p class="text-muted">@Model.Event.EventDate.ToString("dd MMM yyyy") &middot; @Model.Event.Location</p>

<div class="card rd-card p-4 mb-4">
    <h5>Add a category</h5>
    <form asp-action="AddCategory" asp-route-eventId="@Model.Event.EventId" method="post" class="row g-2">
        <div class="col-md-5">
            <input name="categoryName" class="form-control" placeholder="e.g. 10km or Under 20" maxlength="50" />
        </div>
        <div class="col-md-4">
            <select name="categoryType" class="form-select">
                <option value="">Type...</option>
                <option value="Distance">Distance</option>
                <option value="Age">Age</option>
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-rd w-100">Add category</button>
        </div>
    </form>
</div>

<div class="card rd-card">
    <div class="table-responsive">
        <table class="table mb-0">
            <thead><tr><th>Category</th><th>Type</th></tr></thead>
            <tbody>
                @foreach (var c in Model.Categories.OrderBy(c => c.CategoryType).ThenBy(c => c.CategoryName))
                {
                    <tr>
                        <td><strong>@c.CategoryName</strong></td>
                        <td><span class="badge rd-type">@c.CategoryType</span></td>
                    </tr>
                }
                @if (!Model.Categories.Any())
                {
                    <tr><td colspan="2" class="text-center text-muted py-4">No categories yet. Add one above so participants can enter.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>