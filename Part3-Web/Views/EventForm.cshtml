@model EventFormViewModel
@{
    ViewData["Title"] = Model.IsEdit ? "Edit event" : "New event";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card rd-card p-4">
            <h2 class="mb-3">@(Model.IsEdit ? "Edit event" : "Create an event")</h2>

            <form asp-action="@(Model.IsEdit ? "EditEvent" : "CreateEvent")"
                  asp-route-id="@(Model.IsEdit ? Model.EventId : (int?)null)"
                  method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="ExistingBannerUrl" />

                <div class="mb-3">
                    <label asp-for="EventName" class="form-label"></label>
                    <input asp-for="EventName" class="form-control" />
                    <span asp-validation-for="EventName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="EventDate" class="form-label"></label>
                        <input asp-for="EventDate" type="date" class="form-control" />
                        <span asp-validation-for="EventDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Location" class="form-label"></label>
                        <input asp-for="Location" class="form-control" />
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Distance" class="form-label"></label>
                        <input asp-for="Distance" type="number" step="0.01" min="0.01" class="form-control" />
                        <span asp-validation-for="Distance" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="EventType" class="form-label"></label>
                        <select asp-for="EventType" class="form-select">
                            <option value="">Choose a type...</option>
                            <option value="Run">Run</option>
                            <option value="Walk">Walk</option>
                            <option value="Cycle">Cycle</option>
                        </select>
                        <span asp-validation-for="EventType" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="BannerFile" class="form-label"></label>
                    @if (!string.IsNullOrEmpty(Model.ExistingBannerUrl))
                    {
                        <div class="mb-2">
                            <img src="@Model.ExistingBannerUrl" alt="Current banner" style="max-height:140px;" class="rounded" />
                            <div class="form-text">Choose a new image below to replace this banner.</div>
                        </div>
                    }
                    <input asp-for="BannerFile" type="file" accept="image/*" class="form-control" />
                    <div class="form-text">Optional. JPG, PNG, GIF or WEBP, up to 5 MB.</div>
                    <span asp-validation-for="BannerFile" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-rd">@(Model.IsEdit ? "Save changes" : "Create event")</button>
                <a class="btn btn-outline-secondary" asp-action="Events">Cancel</a>
            </form>
        </div>
    </div>
</div>